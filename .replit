# Блок 1: Блок конфигурации запуска и языка
run = "python3 main.py"

# Основной язык проекта — влияет на подсветку синтаксиса и инструменты
language = "python3"
entrypoint = "main.py"
# A list of globs that specify which files and directories should
# be hidden in the workspace.
hidden = ["venv", ".config", "**/__pycache__", "**/.mypy_cache", "**/*.pyc"]
modules = ["python-3.10"]
# Блок 2: Блок конфигурации системного окружения Nix
# Specifies which nix channel to use when building the environment.
[nix]
channel = "stable-22_11"
packages = ["gdb"]
# Блок 3: Блок переменных окружения
[env]
# Блок 4: Блок конфигурации юнит-тестирования
# Enable unit tests. This is only supported for a few languages.
[unitTest]
language = "python3"
# Блок 5: Блок настройки импорта из GitHub
# These are the files that need to be preserved when this 
# language template is used as the base language template
# for Python repos imported from GitHub
[gitHubImport]
requiredFiles = [".replit", "replit.nix", ".config", "venv"]
# Блок 6: Блок конфигурации развёртывания (deployment)
[deployment]
run = ["sh", "-c", "python3 main.py"]

[[ports]]
localPort = 5000
externalPort = 80

[agent]
expertMode = true
